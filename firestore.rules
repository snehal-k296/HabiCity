rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow create (first-time doc) and update, but never delete the user doc itself.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    // block naive client-side tampering: gold can never go negative
                    && request.resource.data.gold >= 0;
      allow delete: if false;

      match /domains/{domainId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      // block naive client-side tampering: XP can never decrease
                      && request.resource.data.totalXp >= resource.data.totalXp;
        allow delete: if request.auth != null && request.auth.uid == userId;

        match /tasks/{taskId} {
          allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Small mirrored doc per user with only what's needed for the friends
    // list and leaderboard (display name, friend code, total XP, streak).
    // Any signed-in user can read any public profile (that's what powers
    // "look someone up by friend code" and the leaderboard) — but only the
    // owner can ever write their own.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.totalXp >= resource.data.totalXp;
      allow delete: if false;
    }
  }
}
